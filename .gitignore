# --- Python ---
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# --- Lean / lake ---
lean/.lake/
lean/build/
*.olean

# Pickled warm REPL environments (large, regenerable)
pickles/

# lean-interact creates an empty concurrency-control lock file next to the Lean
# project directory (not to be confused with uv.lock, which we DO track).
/lean.lock

# --- OS / editor junk ---
.DS_Store
.idea/

# Keep .vscode/settings.json trackable; ignore the rest of .vscode
.vscode/*
!.vscode/settings.json

# --- Secrets ---
.env

# Throwaway local experiments/calibration probes — never pushed.
scratch/

# Bedrock call-log provenance (JSONL) — local record of real request/response payloads,
# never something to commit.
bedrock/output/
