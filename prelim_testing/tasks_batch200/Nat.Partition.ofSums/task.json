  "signature": {
    "name": "VTask.ofSums",
    "type": "(n : ℕ) -> (l : Multiset ℕ) -> (hl : l.sum = n) -> n.Partition",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "l.sum = n",
    "variables": [
      "n",
      "l",
      "hl"
    ],
    "conventions": [
      {
        "point": "zero filtering",
        "statement": "All zero entries in `l` are dropped from the parts of the resulting partition; `(VTask.ofSums n l hl).parts.count 0 = 0` always holds.",
        "note": "Zeros are junk values in the sense of partitions (parts must be positive); they are silently discarded."
      },
      {
        "point": "nonzero count preservation",
        "statement": "For any `i ≠ 0`, `(VTask.ofSums n l hl).parts.count i = l.count i`; nonzero multiplicities are carried over unchanged.",
        "note": "This is the complementary convention to zero-filtering: everything positive is kept exactly."
      }
    ]
  },
