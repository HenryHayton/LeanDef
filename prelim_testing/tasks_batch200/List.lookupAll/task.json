    "conventions": [
      {
        "point": "empty list",
        "statement": "VTask.lookupAll a [] = []  for any key a",
        "note": "The empty list trivially has no entries to match."
      },
      {
        "point": "non-matching head",
        "statement": "When the head entry has a key different from a, it is skipped and lookupAll recurses on the tail unchanged.",
        "note": "No junk value is produced; the entry simply does not contribute to the output."
      }
    ]
  },
