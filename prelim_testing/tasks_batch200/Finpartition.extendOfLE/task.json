  "signature": {
    "name": "VTask.extendOfLE",
    "type": "{α : Type u_1} -> [GeneralizedBooleanAlgebra α] -> [DecidableEq α] -> {a b : α} -> (P : Finpartition a) -> (hab : a ≤ b) -> Finpartition b",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "P",
      "hab"
    ],
    "conventions": [
      {
        "point": "a = b (i.e., b \\ a = ⊥)",
        "statement": "When a = b, VTask.extendOfLE P hab returns a finpartition whose parts are exactly P.parts; the element b \\ a = ⊥ is not added as a part.",
        "note": "Degenerate case: the extension is the identity on parts."
      },
      {
        "point": "a < b (i.e., b \\ a ≠ ⊥)",
        "statement": "When a < b, VTask.extendOfLE P hab returns a finpartition whose parts are insert (b \\ a) P.parts; exactly one new part b \\ a is adjoined.",
        "note": "Generic case: the leftover piece b \\ a becomes the unique new part."
      }
    ]
  },
  "axiom_baseline": [
    "Classical.choice",
    "Quot.sound",
    "propext"
  ],
