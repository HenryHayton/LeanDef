    "conventions": [
      {
        "point": "reflexivity",
        "statement": "VTask.WCovBy a a holds for every element a in any preorder, making the relation reflexive.",
        "note": "This is the key difference from the strict cover relation CovBy."
      },
      {
        "point": "empty_open_interval",
        "statement": "VTask.WCovBy a b holds if and only if a ≤ b and the open interval Ioo a b is empty.",
        "note": "Characterises the relation purely in terms of the order intervals."
      }
    ]
