    ],
    "conventions": [
      {
        "point": "Negative integers use two's-complement with infinite leading 1-bits",
        "statement": "A negative integer -[k+1] is treated as having all bit positions above its magnitude set to 1, so VTask.lor (-1) n = -1 for all n : ℤ.",
        "note": "This is the standard two's-complement extension of bitwise OR to ℤ."
      }
    ]
  },
