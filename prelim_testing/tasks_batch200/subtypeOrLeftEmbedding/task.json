    ],
    "conventions": [
      {
        "point": "p-priority routing",
        "statement": "When p x holds, the element is sent to Sum.inl regardless of whether q x also holds.",
        "note": "Left predicate p takes strict priority over q in routing decisions."
      },
      {
        "point": "right routing requires ¬p x",
        "statement": "When ¬p x holds (and hence q x must hold by membership in the domain), the element is sent to Sum.inr.",
        "note": "The right summand is used exactly for elements where p fails."
      }
    ]
  },
