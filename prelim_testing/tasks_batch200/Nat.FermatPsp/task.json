  "task_symbol": "VTask.FermatPsp",
  "signature": {
    "name": "VTask.FermatPsp",
    "type": "(n b : ℕ) -> Prop",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "n",
      "b"
    ],
    "conventions": [
      {
        "point": "base 0 or base 1",
        "statement": "Every composite natural number greater than 1 is a Fermat pseudoprime to base 0 and to base 1, because the probable-prime condition holds trivially in those cases.",
        "note": "Follows from the definition of ProbablePrime at these degenerate bases."
      },
      {
        "point": "n = 0 or n = 1",
        "statement": "Neither 0 nor 1 is ever a Fermat pseudoprime, regardless of the base, because the predicate requires 1 < n.",
        "note": "Hard lower-bound convention built into the definition."
      },
      {
        "point": "n < b permitted",
        "statement": "There is no requirement that n be at least as large as b; for example, 4 is a Fermat pseudoprime to base 5.",
        "note": "Explicitly noted in the docstring."
      }
    ]
  },
