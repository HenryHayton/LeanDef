    ],
    "conventions": [
      {
        "point": "ε ≤ 0",
        "statement": "When ε ≤ 0, IsUniform G ε s t is vacuously false (the required strict inequality |density difference| < ε cannot hold since absolute values are non-negative), except in degenerate cases; in practice the property is only meaningful for 0 < ε < 1.",
        "note": "Follows from the fact that any proof of IsUniform G ε s t for a non-trivial pair implies 0 < ε, as recorded in IsUniform.pos."
      }
    ]
  },
