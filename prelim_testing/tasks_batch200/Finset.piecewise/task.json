  "schema_version": "1.1",
  "task_symbol": "VTask.piecewise",
  "signature": {
    "name": "VTask.piecewise",
    "type": "{ι : Type u_1} -> {π : ι → Sort u_2} -> (s : Finset ι) -> (f g : (i : ι) → π i) -> [(j : ι) → Decidable (j ∈ s)] -> (i : ι) -> π i",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "s",
      "f",
      "g",
      "i"
    ],
    "conventions": [
      {
        "point": "s = ∅",
        "statement": "VTask.piecewise ∅ f g = g, because no index belongs to the empty set and g is used everywhere.",
        "note": "Corresponds to Finset.piecewise_empty"
      },
      {
        "point": "f = g",
        "statement": "VTask.piecewise s f f = f, because both branches return the same function regardless of membership.",
        "note": "Corresponds to Finset.piecewise_same"
      },
      {
        "point": "s = {i} singleton",
        "statement": "VTask.piecewise {i} f g = Function.update g i (f i), i.e., the result is g with the single index i changed to f i.",
        "note": "Corresponds to Finset.piecewise_singleton"
      }
    ]
  },
  "axiom_baseline": [
    "Quot.sound",
    "propext"
  ],
  "admissibility_contract": {
    "single_declaration": true
  },
