    ],
    "conventions": [
      {
        "point": "n = 0, u ≠ v",
        "statement": "When the required length is 0 and the start and end vertices differ, the returned finset is empty, since no walk of length zero can connect distinct vertices.",
        "note": "Edge case by structural recursion on n and decidable equality on V."
      },
      {
        "point": "n = 0, u = v",
        "statement": "When the required length is 0 and the start equals the end vertex, the returned finset contains exactly the single nil walk at that vertex.",
        "note": "The nil walk is the unique walk of length zero from any vertex to itself."
      }
    ]
  },
