    "name": "VTask.finsetWalkLength",
    "type": "{V : Type u} -> (G : SimpleGraph V) -> [DecidableEq V] -> [G.LocallyFinite] -> (n : ℕ) -> (u v : V) -> Finset (G.Walk u v)",
    "imports": [
