    "conventions": [
      {
        "point": "empty list",
        "statement": "VTask.nextOr [] x default = default for all x and default.",
        "note": "Base case: no elements means no successor is possible."
      },
      {
        "point": "singleton list",
        "statement": "VTask.nextOr [y] x default = default for all x, y, and default.",
        "note": "A single element has no successor element in the list."
      },
      {
        "point": "x is last element without earlier occurrence having a successor",
        "statement": "VTask.nextOr xs x default = default when x appears in xs only as the last element.",
        "note": "The last element has no successor, so default is returned."
      },
      {
        "point": "x not in list",
        "statement": "VTask.nextOr xs x default = default when x does not appear in xs.",
        "note": "No match found means the default is returned."
      },
      {
        "point": "first match wins",
        "statement": "When x appears multiple times in xs, the successor of the first occurrence is returned.",
        "note": "The function scans left-to-right and stops at the first matching position."
      }
    ]
  },
