    "conventions": [
      {
        "point": "empty list",
        "statement": "VTask.nextOr [] x default = default for all x and default.",
        "note": "Defined by the base case: searching an empty list always returns the default."
      },
      {
        "point": "singleton list",
        "statement": "VTask.nextOr [y] x default = default for all x, y, and default.",
        "note": "A one-element list has no consecutive pair, so no successor can be found."
      },
      {
        "point": "x is the last element",
        "statement": "If x appears in xs only at the final position (or only at positions without a following element), VTask.nextOr xs x default = default.",
        "note": "There is no wraparound; the last element is treated as having no successor."
      }
    ]
  },
