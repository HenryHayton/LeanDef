    "conventions": [
      {
        "point": "VTask.stirlingFirst 0 0 = 1",
        "statement": "The empty permutation (on 0 elements) is counted as having exactly 0 cycles, so the value is 1.",
        "note": "Standard combinatorial convention: the empty permutation is the unique element of Sym(∅)."
      },
      {
        "point": "VTask.stirlingFirst 0 (k+1) = 0 for all k",
        "statement": "There are no permutations of the empty set with a positive number of cycles.",
        "note": "Junk/boundary value for the empty set with k ≥ 1."
      },
      {
        "point": "VTask.stirlingFirst (n+1) 0 = 0 for all n",
        "statement": "A permutation of a non-empty set always has at least one cycle, so 0 cycles is impossible.",
        "note": "Junk/boundary value for n ≥ 1 with k = 0."
      },
      {
        "point": "VTask.stirlingFirst n k = 0 when k > n",
        "statement": "You cannot have more disjoint cycles than elements, so values with k > n are set to 0.",
        "note": "Structurally forced by the recurrence; not a junk value in the usual sense but follows from the definition."
      }
    ]
  },
