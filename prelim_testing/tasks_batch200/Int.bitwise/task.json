    ],
    "conventions": [
      {
        "point": "Two's complement sign extension for negative integers",
        "statement": "Negative integers have infinitely many `true` bits beyond their finite pattern (sign bit = 1), while non-negative integers have infinitely many `false` bits; this makes `VTask.bitwise f m n` well-defined at all bit positions for all integers.",
        "note": "This convention means that if `f false false = true`, then `VTask.bitwise f` applied to two non-negative integers yields a negative integer."
      },
      {
        "point": "Result is negative when f false false = true",
        "statement": "When `f false false = true`, the result of `VTask.bitwise f m n` for non-negative `m` and `n` is a negative integer (specifically, the infinitely many upper bits all evaluate to `true`, giving a two's-complement negative number).",
        "note": "No junk value is produced; the definition is total and this is the mathematically correct behaviour under two's-complement semantics."
      }
    ]
  },
  "axiom_baseline": [
    "propext"
  ],
