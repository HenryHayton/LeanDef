    "conventions": [
      {
        "point": "trailing zeros in w",
        "statement": "If w contains trailing zero entries, the construction succeeds and those rows contribute no cells; however, the canonical rowLens of the resulting Young diagram omits trailing zeros, so ofRowLens w hw and ofRowLens w' hw' can be equal even when w ≠ w' if they differ only in trailing zeros.",
        "note": "This is the standard junk-value convention for row-lens representations of Young diagrams."
      }
    ]
  },
