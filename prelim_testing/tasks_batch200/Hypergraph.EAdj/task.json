    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "H",
      "e",
      "f"
    ],
    "conventions": [
      {
        "point": "Both arguments must be edges of H",
        "statement": "VTask.EAdj H e f is False whenever e ∉ E(H) or f ∉ E(H), regardless of vertex overlap.",
        "note": "Membership in E(H) is a hard requirement built into the definition."
      },
      {
        "point": "Witnessing vertex need not be explicitly in V(H) in the bare definition",
        "statement": "The existential ∃ x, x ∈ e ∧ x ∈ f does not directly require x ∈ V(H), though a strengthening lemma (EAdj.exists_vertex) shows such a witness can always be found in V(H).",
        "note": "This is a subtle distinction between the bare definition and the derived lemma."
      }
    ]
  },
