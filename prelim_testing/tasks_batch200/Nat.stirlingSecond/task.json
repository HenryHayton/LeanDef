    "name": "VTask.stirlingSecond",
    "type": "ℕ → ℕ → ℕ",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "n",
      "k"
    ],
    "conventions": [
      {
        "point": "S(0,0) = 1",
        "statement": "The empty set has exactly one partition into zero non-empty blocks (the vacuous partition), so VTask.stirlingSecond 0 0 = 1.",
        "note": "Standard combinatorial convention for the empty partition."
      },
      {
        "point": "S(0, k+1) = 0",
        "statement": "There is no way to form even one non-empty block from an empty set, so VTask.stirlingSecond 0 (k+1) = 0 for all k.",
        "note": "Impossible partition; zero is the natural junk/boundary value."
      },
      {
        "point": "S(n+1, 0) = 0",
        "statement": "A non-empty set cannot be partitioned into zero blocks, so VTask.stirlingSecond (n+1) 0 = 0 for all n.",
        "note": "Impossible partition; zero is the natural junk/boundary value."
      },
      {
        "point": "S(n, k) = 0 when k > n",
        "statement": "When the number of required blocks exceeds the number of elements, no valid partition exists, so VTask.stirlingSecond n k = 0 whenever k > n.",
        "note": "Follows from the impossibility of placing n elements into more than n non-empty blocks."
      }
    ]
  },
