    ],
    "conventions": [
      {
        "point": "k < j",
        "statement": "When the output index k (as a natural number) is strictly less than j, the result is g applied to the coercion of k to Fin (n + 1) via castSucc, i.e., the original entry is passed through unchanged.",
        "note": "Left-of-merge passthrough"
      },
      {
        "point": "k = j",
        "statement": "When the output index k equals j (as natural numbers), the result is op applied to the original entries at positions j and j + 1, i.e., op (g (castSucc k)) (g k.succ).",
        "note": "Merge point"
      },
      {
        "point": "k > j",
        "statement": "When the output index k (as a natural number) is strictly greater than j, the result is g applied to k.succ, i.e., the entry one position higher in the original tuple is returned.",
        "note": "Right-of-merge passthrough with index shift"
      }
    ]
  },
