  "signature": {
    "name": "VTask.pi",
    "type": "{α : Type u_1} -> {β : α → Type u} -> [DecidableEq α] -> (s : Finset α) -> (t : (a : α) → Finset (β a)) -> Finset ((a : α) → a ∈ s → β a)",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "s",
      "t"
    ],
    "conventions": [
      {
        "point": "s = ∅",
        "statement": "When s is the empty finset, VTask.pi s t is the singleton containing the unique empty function Pi.empty β, regardless of t.",
        "note": "Standard convention: a dependent product over an empty index set has exactly one element."
      },
      {
        "point": "t a = ∅ for some a ∈ s",
        "statement": "When t a is empty for at least one index a that belongs to s, VTask.pi s t is the empty finset.",
        "note": "No function can choose a value for an index whose fiber is empty."
      },
      {
        "point": "a ∉ s",
        "statement": "The value of t a for indices a not in s has no effect on VTask.pi s t.",
        "note": "Functions in the result only need to be defined on s; t is consulted only at indices inside s."
      }
    ]
  },
