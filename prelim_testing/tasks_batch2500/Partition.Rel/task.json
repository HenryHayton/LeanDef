    "name": "VTask.Rel",
    "type": "{α : Type u_1} -> {s : Set α} -> (P : Partition s) -> (a b : α) -> Prop",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "a",
      "b"
    ],
    "conventions": [
      {
        "point": "irreflexivity outside s",
        "statement": "If a ∉ s, then VTask.Rel P a a is false (and VTask.Rel P a b is false for all b).",
        "note": "The relation is irreflexive — and in fact universally false in one argument — for elements outside the partitioned set s."
      },
      {
        "point": "reflexivity inside s",
        "statement": "VTask.Rel P a a holds if and only if a ∈ s.",
        "note": "This is the boundary between the 'in-domain' and 'junk' regimes for this relation."
      }
    ]
  },
