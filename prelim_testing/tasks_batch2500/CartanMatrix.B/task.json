  "task_symbol": "VTask.B",
  "signature": {
    "name": "VTask.B",
    "type": "(n : ℕ) -> Matrix (Fin n) (Fin n) ℤ",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "n"
    ],
    "conventions": [
      {
        "point": "n = 0",
        "statement": "VTask.B 0 is the empty 0×0 matrix, a junk value with no Lie-algebraic meaning.",
        "note": "No Lie algebra of type B₀ exists; this is a degenerate edge case of the definition."
      },
      {
        "point": "n = 1",
        "statement": "VTask.B 1 equals the 1×1 matrix [[2]], coinciding with the A₁ Cartan matrix.",
        "note": "There is only one simple root so no off-diagonal entries exist and no asymmetry appears."
      },
      {
        "point": "Diagonal entries",
        "statement": "For all n and all i : Fin n, VTask.B n i i = 2.",
        "note": "This is the standard Cartan matrix convention: all diagonal entries are 2."
      },
      {
        "point": "Off-diagonal entry at the long-short boundary",
        "statement": "For n ≥ 2, the entry VTask.B n (n-2) (n-1) = -2, reflecting the short final simple root.",
        "note": "This is the only off-diagonal entry equal to -2; it encodes the asymmetry of the Bₙ Dynkin diagram."
      },
      {
        "point": "All other off-diagonal entries",
        "statement": "Off-diagonal entries of VTask.B n are either -1 (for adjacent non-boundary pairs), -2 (at the distinguished boundary), or 0 (for non-adjacent pairs); in particular all off-diagonal entries are non-positive.",
        "note": "This is a general property of Cartan matrices."
      }
    ]
  },
  "axiom_baseline": [
    "Quot.sound"
  ],
  "admissibility_contract": {
    "single_declaration": true
  },
