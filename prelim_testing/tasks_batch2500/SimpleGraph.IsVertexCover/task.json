    ],
    "conventions": [
      {
        "point": "empty cover",
        "statement": "VTask.IsVertexCover G ∅ holds if and only if G has no edges (G = ⊥); it is False for any graph with at least one edge.",
        "note": "This is a genuine logical equivalence, not a junk-value convention."
      },
      {
        "point": "full cover",
        "statement": "VTask.IsVertexCover G Set.univ is always True for any graph G, since every vertex belongs to Set.univ.",
        "note": "No special convention needed; follows directly from the definition."
      },
      {
        "point": "edgeless graph",
        "statement": "VTask.IsVertexCover ⊥ c holds for every set c, since there are no edges to cover.",
        "note": "Vacuously true; no junk-value convention involved."
      }
    ]
  },
