    "conventions": [
      {
        "point": "o = 0",
        "statement": "VTask.split 0 = (0, 0): both the ω-divisible part and the remainder are zero.",
        "note": "Base case of the structural recursion."
      },
      {
        "point": "o = oadd 0 n a (leading exponent is zero)",
        "statement": "VTask.split (oadd 0 n a) = (0, n): the ω-divisible part is 0 and the remainder is the coefficient n; the sub-term a is discarded.",
        "note": "Any well-formed oadd with exponent 0 has a = 0, so discarding a is lossless for NF inputs."
      },
      {
        "point": "o = oadd e n a with e ≠ 0 (leading exponent is nonzero)",
        "statement": "VTask.split (oadd e n a) = (oadd e n a', m) where (a', m) = VTask.split a: the leading monomial is kept in the ω-divisible part and the remainder is recursively computed from the tail.",
        "note": "This propagates the finite remainder from the lower-order tail of the Cantor normal form."
      }
    ]
  },
