  "task_symbol": "VTask.sym2",
  "signature": {
    "name": "VTask.sym2",
    "type": "{α : Type u_1} -> List α → List (Sym2 α)",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "xs"
    ],
    "conventions": [
      {
        "point": "diagonal pairs included",
        "statement": "For any element `a` in `xs`, the diagonal pair `s(a, a)` is included in `VTask.sym2 xs`; the function does not exclude equal-component pairs.",
        "note": "This means the output is all unordered pairs with repetition allowed (multiset pairs), not just strictly off-diagonal ones."
      },
      {
        "point": "each unordered pair once when no duplicates",
        "statement": "Because `Sym2` identifies `s(a, b)` with `s(b, a)`, when `xs` has no duplicates each unordered pair appears exactly once in `VTask.sym2 xs`.",
        "note": "Follows from `List.Nodup.sym2`."
      }
    ]
  },
