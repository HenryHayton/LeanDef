    "conventions": [
      {
        "point": "n = 0",
        "statement": "VTask.thinkN c 0 = c; zero delay is the identity on computations.",
        "note": "Base case of the recursive definition."
      },
      {
        "point": "n = k + 1",
        "statement": "VTask.thinkN c (k + 1) = Computation.think (VTask.thinkN c k); each successor step wraps the partially-delayed computation in one additional think.",
        "note": "Inductive case: delays are counted outward-inward, so the outermost think is the last one added."
      }
    ]
  },
