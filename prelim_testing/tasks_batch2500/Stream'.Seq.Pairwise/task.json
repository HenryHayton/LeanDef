    "conventions": [
      {
        "point": "vacuous quantification over absent elements",
        "statement": "If `s.get? i = none` or `s.get? j = none` for some pair `i < j`, the condition for that pair is vacuously true; terminated or empty portions of the sequence impose no constraint.",
        "note": "This makes `VTask.Pairwise R nil` and `VTask.Pairwise R (cons hd nil)` trivially true for all `R`."
      }
    ]
