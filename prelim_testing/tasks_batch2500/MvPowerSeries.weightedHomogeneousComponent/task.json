        "point": "coefficient of d when weight w d = p",
        "statement": "The coefficient of multi-index d in VTask.weightedHomogeneousComponent w p f equals coeff d f whenever weight w d = p.",
        "note": "This is the defining retention rule."
      },
      {
        "point": "coefficient of d when weight w d ≠ p",
        "statement": "The coefficient of multi-index d in VTask.weightedHomogeneousComponent w p f is 0 whenever weight w d ≠ p.",
        "note": "This is the defining zeroing-out rule."
      },
      {
        "point": "p strictly less than weighted order",
        "statement": "If p < weightedOrder w f, then VTask.weightedHomogeneousComponent w p f = 0.",
        "note": "No monomial of that degree appears in f."
      }
    ]
  },
