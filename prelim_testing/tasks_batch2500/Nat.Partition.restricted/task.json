  "signature": {
    "name": "VTask.restricted",
    "type": "(n : ℕ) -> (p : ℕ → Prop) -> [DecidablePred p] -> Finset n.Partition",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "n",
      "p"
    ],
    "conventions": [
      {
        "point": "vacuous satisfaction when n = 0",
        "statement": "When n = 0 the unique partition is the empty partition; it has no parts, so the condition ∀ i ∈ parts, p i holds vacuously and VTask.restricted 0 p is always a singleton.",
        "note": "This holds for every decidable predicate p, including p = fun _ => False."
      },
      {
        "point": "predicate tested on each part value, not on the partition globally",
        "statement": "The predicate p is evaluated on each individual part (a positive natural number) of the partition; the whole-partition sum n is never passed to p.",
        "note": "Parts with multiplicity > 1 must each individually satisfy p."
      }
    ]
  },
  "axiom_baseline": [
    "Classical.choice",
    "Quot.sound",
    "propext"
  ],
