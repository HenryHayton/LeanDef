  "task_symbol": "VTask.compl",
  "signature": {
    "name": "VTask.compl",
    "type": "{α : Type u_1} -> {V : Type u_2} -> [Zero α] -> [One α] -> [DecidableEq α] -> [DecidableEq V] -> (A : Matrix V V α) -> Matrix V V α",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "A"
    ],
    "conventions": [
      {
        "point": "diagonal",
        "statement": "For any matrix A and any index i, A.compl i i = 0 regardless of the value of A i i.",
        "note": "Encodes the no-self-loop convention for graphs."
      },
      {
        "point": "off-diagonal nonzero",
        "statement": "For i ≠ j, if A i j ≠ 0 then A.compl i j = 0 (edge present in A means absent in complement).",
        "note": "Any nonzero value, not just 1, is treated as a present edge."
      },
      {
        "point": "off-diagonal zero",
        "statement": "For i ≠ j, if A i j = 0 then A.compl i j = 1 (edge absent in A means present in complement).",
        "note": "Output is always in {0, 1} regardless of input range."
      }
    ]
  },
  "axiom_baseline": [
    "Quot.sound"
  ],
  "admissibility_contract": {
