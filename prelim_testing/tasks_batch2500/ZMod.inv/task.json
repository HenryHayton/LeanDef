  "signature": {
    "name": "VTask.inv",
    "type": "(n : ℕ) -> ZMod n → ZMod n",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "n",
      "a"
    ],
    "conventions": [
      {
        "point": "n = 0 case",
        "statement": "When n = 0, ZMod 0 is identified with ℤ and VTask.inv 0 is the integer sign function: it maps positive integers to 1, negative integers to -1, and 0 to 0.",
        "note": "This is an edge case where the general gcd identity holds in ℤ but the sign function is used as the inversion map."
      },
      {
        "point": "zero element",
        "statement": "For every n : ℕ, VTask.inv n 0 = 0; equivalently (0 : ZMod n)⁻¹ = 0.",
        "note": "Consistent with the identity a * a⁻¹ = gcd(val a, n) since gcd(0, n) = n which equals 0 in ZMod n."
      },
      {
        "point": "non-units",
        "statement": "When gcd(val(a), n) > 1, VTask.inv n a is still a well-defined element of ZMod n, but a * (VTask.inv n a) = gcd(val a, n) ≠ 1, so it is not a true multiplicative inverse.",
        "note": "The function is total and assigns a junk value (in the group-inverse sense) to non-units; it is the Bézout coefficient from the extended Euclidean algorithm reduced mod n."
      }
    ]
  },
  "axiom_baseline": [
    "Quot.sound",
    "propext"
  ],
  "admissibility_contract": {
    "single_declaration": true
  },
