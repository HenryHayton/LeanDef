  "signature": {
    "name": "VTask.val",
    "type": "{n : ℕ} -> ZMod n → ℕ",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "n",
      "a"
    ],
    "conventions": [
      {
        "point": "n = 0",
        "statement": "When n = 0, ZMod 0 is the integers and VTask.val returns the absolute value (Int.natAbs) of the integer, not a residue class representative.",
        "note": "This is a genuine junk-value convention: the 'canonical representative' interpretation does not apply to ZMod 0 since there is no modulus to reduce by."
      },
      {
        "point": "n > 0",
        "statement": "When n > 0, VTask.val always returns the unique natural number in {0, 1, …, n-1} representing the residue class, i.e., the least non-negative representative.",
        "note": "The output is bounded: 0 ≤ VTask.val a < n for all a : ZMod n with n > 0."
      }
    ]
  },
