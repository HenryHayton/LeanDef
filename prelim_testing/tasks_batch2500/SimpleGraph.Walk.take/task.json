  "task_id": "SimpleGraph.Walk.take",
  "schema_version": "1.1",
  "task_symbol": "VTask.take",
  "signature": {
    "name": "VTask.take",
    "type": "{V : Type u} -> {G : SimpleGraph V} -> {u v : V} -> (p : G.Walk u v) -> (n : ℕ) -> G.Walk u (p.getVert n)",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "p",
      "n"
    ],
    "conventions": [
      {
        "point": "n = 0",
        "statement": "When n = 0, VTask.take p 0 is the nil walk at u (the start vertex of p), i.e., a walk of length zero traversing no darts.",
        "note": "Junk-value convention: zero darts taken means trivial walk."
      },
      {
        "point": "n ≥ p.length",
        "statement": "When n is greater than or equal to the length of p, VTask.take p n equals p itself; the result saturates at p and ends at v.",
        "note": "Out-of-bounds take is clamped to the full walk."
      }
    ]
  },
