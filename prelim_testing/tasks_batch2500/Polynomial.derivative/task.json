    "conventions": [
      {
        "point": "constant_term",
        "statement": "The constant term (degree-0 coefficient) contributes 0 to the derivative because it is multiplied by the exponent 0; no junk value arises from the natural-number underflow 0 - 1.",
        "note": "The subtraction 0 - 1 in ℕ evaluates to 0, but the coefficient factor n = 0 forces the whole term to vanish."
      },
      {
        "point": "characteristic_p_kernel",
        "statement": "Over a semiring of characteristic p > 0, the formal derivative of X^p is 0, since the coefficient p becomes 0 in R; this is not a special junk convention but the correct algebraic value.",
        "note": "Polynomials of the form f(X^p) lie entirely in the kernel of the formal derivative in characteristic p."
      }
    ]
  },
