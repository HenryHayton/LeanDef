  "domain": {
    "constraint": "True",
    "variables": [
      "p",
      "L"
    ],
    "conventions": [
      {
        "point": "no_element_found_suffix",
        "statement": "When no element of L satisfies p, the third component of the result is [] (the empty list), not some slice of L.",
        "note": "This is an asymmetric convention: the whole list appears as the prefix, nothing as the pivot, and an empty list as the suffix."
      },
      {
        "point": "first_match_only",
        "statement": "Only the first element satisfying p is used as the pivot; elements after it that also satisfy p are left untouched in the suffix.",
        "note": "This ensures the decomposition L = l₁ ++ [a] ++ l₂ is uniquely determined by the leftmost satisfying position."
      }
    ]
  },
