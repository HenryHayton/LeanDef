  "task_symbol": "VTask.weierstrassPExceptSeries",
  "signature": {
    "name": "VTask.weierstrassPExceptSeries",
    "type": "(L : PeriodPair) -> (l₀ x : ℂ) -> FormalMultilinearSeries ℂ ℂ ℂ",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "L",
      "l₀",
      "x"
    ],
    "conventions": [
      {
        "point": "zeroth coefficient",
        "statement": "The coefficient at index i = 0 is defined to be the value ℘[L - l₀] x, i.e., the evaluation of the removed-pole Weierstrass ℘-function at the expansion centre x.",
        "note": "This is a junk-value convention in the sense that the series is defined for all x, even poles of ℘[L - l₀], where this value would be infinite."
      },
      {
        "point": "l₀ not in lattice",
        "statement": "When l₀ ∉ L.lattice, the correction term in all higher-degree coefficients is zero, and the series coincides with the standard Weierstrass ℘ power series L.weierstrassPSeries.",
        "note": "No lattice membership check is needed in that case; the two series are definitionally equal."
      }
    ]
  },
  "axiom_baseline": [
    "Classical.choice",
    "Quot.sound",
    "propext"
  ],
