  "domain": {
    "constraint": "True",
    "variables": [
      "f",
      "v"
    ],
    "conventions": [
      {
        "point": "injective f",
        "statement": "When f is injective, VTask.mapDomain f v preserves individual values: for each x in the support of v, the value at f(x) in the result equals v(x), with no accumulation.",
        "note": "This is the renaming/relabelling special case."
      },
      {
        "point": "non-injective f",
        "statement": "When f is not injective and multiple support points of v share the same image, their coefficients are summed at that image point in the result.",
        "note": "Standard push-forward accumulation behaviour."
      },
      {
        "point": "empty support",
        "statement": "When v is the zero finsupp (empty support), VTask.mapDomain f v is the zero finsupp for any f.",
        "note": "Consistent with the sum-over-empty-fibre being zero."
      }
    ]
  },
