    "conventions": [
      {
        "point": "n = 0",
        "statement": "VTask.C 0 is the unique 0×0 matrix; all row and column conditions hold vacuously.",
        "note": "Junk-value convention: the empty matrix is the only well-typed value at rank 0."
      },
      {
        "point": "n = 1",
        "statement": "VTask.C 1 equals the 1×1 matrix [[2]], which coincides with the type-A₁ Cartan matrix since there are no off-diagonal entries and the last-row −2 rule has no effect.",
        "note": "The −2 sub-diagonal entry only appears when the last row index n−1 has a valid predecessor, which requires n ≥ 2."
      }
    ]
  },
