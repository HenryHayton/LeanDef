    "name": "VTask.pi",
    "type": "{ι : Type u_3} -> {α : ι → Type u_4} -> (f : (i : ι) → Filter (α i)) -> Filter ((i : ι) → α i)",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "f"
    ],
    "conventions": [
      {
        "point": "empty index",
        "statement": "When ι is empty, VTask.pi f equals the top filter ⊤ on the (one-element) product type, because an infimum over an empty family in the filter lattice is ⊤.",
        "note": "Standard lattice convention: ⨅ over empty family = ⊤."
      },
      {
        "point": "bottom factor",
        "statement": "If any f i equals the bottom filter ⊥, then VTask.pi f equals ⊥, because taking the infimum with a comap of ⊥ yields ⊥.",
        "note": "Follows from the definition as an infimum of comaps."
      }
    ]
  },
  "axiom_baseline": [
