    "conventions": [
      {
        "point": "Parity of negative integers",
        "statement": "A negative integer -(k+1) is considered odd if and only if the natural number k is even; equivalently, VTask.bodd (-(k+1)) = !Nat.bodd k.",
        "note": "This ensures parity is invariant under negation: bodd (-n) = bodd n for all n : ℤ."
      }
    ]
  },
