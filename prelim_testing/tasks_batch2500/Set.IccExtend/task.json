  "task_symbol": "VTask.IccExtend",
  "signature": {
    "name": "VTask.IccExtend",
    "type": "{α : Type u_1} -> {β : Type u_2} -> [LinearOrder α] -> {a b : α} -> (h : a ≤ b) -> (f : ↑(Set.Icc a b) → β) -> α → β",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "h",
      "f",
      "x"
    ],
    "conventions": [
      {
        "point": "x ≤ a",
        "statement": "VTask.IccExtend h f x = f ⟨a, left_mem_Icc.2 h⟩",
        "note": "Left-endpoint clamping: any input at or below a is mapped to the value of f at a."
      },
      {
        "point": "x ∈ Set.Icc a b",
        "statement": "VTask.IccExtend h f x = f ⟨x, hx⟩",
        "note": "On-interval behavior: for x inside [a,b], the extension agrees with f."
      },
      {
        "point": "b ≤ x",
        "statement": "VTask.IccExtend h f x = f ⟨b, right_mem_Icc.2 h⟩",
        "note": "Right-endpoint clamping: any input at or above b is mapped to the value of f at b."
      },
      {
        "point": "range",
        "statement": "Set.range (VTask.IccExtend h f) = Set.range f",
        "note": "The extension does not introduce new values; its range equals the range of the original f."
      }
    ]
  },
