      },
      {
        "point": "empty list",
        "statement": "`VTask.IsRotated [] []` is true, and `VTask.IsRotated [] l'` is false whenever `l'` is non-empty.",
        "note": "Rotation of the empty list is always the empty list."
      }
    ]
