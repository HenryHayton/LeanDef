  "signature": {
    "name": "VTask.drop",
    "type": "{V : Type u} -> {G : SimpleGraph V} -> {u v : V} -> (p : G.Walk u v) -> (n : ℕ) -> G.Walk (p.getVert n) v",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "p",
      "n"
    ],
    "conventions": [
      {
        "point": "n = 0",
        "statement": "Dropping zero darts returns the entire original walk, with the start vertex identified via `p.getVert 0 = u`.",
        "note": "Junk-free: n=0 is well-defined and returns the full walk."
      },
      {
        "point": "n ≥ p.length",
        "statement": "When n is at least the length of p, `p.getVert n` equals the terminal vertex v, and the result is a nil walk at v.",
        "note": "Out-of-bounds drop saturates to a nil walk at the endpoint."
      }
    ]
  },
