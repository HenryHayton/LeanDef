  "signature": {
    "name": "VTask.ofFn",
    "type": "{R : Type u_1} -> [Semiring R] -> [DecidableEq R] -> (n : ℕ) -> (Fin n → R) →ₗ[R] Polynomial R",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "n",
      "v"
    ],
    "conventions": [
      {
        "point": "coefficient at index i < n",
        "statement": "The coefficient of `VTask.ofFn n v` at degree `i` (with `i < n`) equals `v ⟨i, _⟩`.",
        "note": "This is the primary intended behavior: the polynomial reads off the vector entries as coefficients."
      },
      {
        "point": "coefficient at index i ≥ n",
        "statement": "The coefficient of `VTask.ofFn n v` at degree `i` (with `i ≥ n`) is `0`.",
        "note": "Out-of-range degrees contribute zero, which is consistent with polynomial semantics and not a junk value."
      },
      {
        "point": "n = 0 case",
        "statement": "When `n = 0`, `VTask.ofFn 0` maps the unique element of `Fin 0 → R` to the zero polynomial.",
        "note": "The empty coefficient vector produces the zero polynomial."
      }
    ]
  },
  "axiom_baseline": [
    "Classical.choice",
    "Quot.sound",
    "propext"
  ],
