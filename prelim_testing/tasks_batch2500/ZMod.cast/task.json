    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "n",
      "i"
    ],
    "conventions": [
      {
        "point": "n = 0",
        "statement": "When n = 0, ZMod 0 is identified with ℤ and VTask.cast reduces to Int.cast.",
        "note": "This is a definitional equality in the implementation."
      },
      {
        "point": "n ≥ 1",
        "statement": "When n = k + 1 for some k, VTask.cast sends an element to the natural-number cast of its canonical representative in {0, …, n−1}.",
        "note": "The canonical representative is given by the .val field of the element."
      }
    ]
  },
