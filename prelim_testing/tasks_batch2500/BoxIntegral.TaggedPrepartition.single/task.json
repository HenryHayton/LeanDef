    "conventions": [
      {
        "point": "uniform tag",
        "statement": "Every box in the single-box collection carries the same tag `x`; the tag function is constant.",
        "note": "This is the only meaningful choice when there is exactly one box."
      },
      {
        "point": "Henstock condition",
        "statement": "The tagged prepartition satisfies the Henstock condition if and only if `x ∈ Box.Icc J`, even though the type only requires `x ∈ Box.Icc I`.",
        "note": "Having `x ∈ Box.Icc I \\ Box.Icc J` is a valid construction but not Henstock."
      },
      {
        "point": "partition vs prepartition",
        "statement": "The result is a full partition of `I` if and only if `J = I`; otherwise it is a strict prepartition with uncovered interior.",
        "note": "NONE_DECLARED: not a junk-value convention but a genuine mathematical fact about the object's completeness."
      }
    ]
  },
