    "name": "VTask.cramerMap",
    "type": "{n : Type v} -> {α : Type w} -> [DecidableEq n] -> [Fintype n] -> [CommRing α] -> (A : Matrix n n α) -> (b : n → α) -> (i : n) -> α",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "A",
      "b",
      "i"
    ],
    "conventions": [
      {
        "point": "empty index type",
        "statement": "When n is empty, there are no indices i, so cramerMap A b is a function with empty domain; no determinant values are produced, but the definition is still well-typed and total.",
        "note": "The 0×0 determinant is 1 by the empty-product convention, but it is inaccessible since there is no i : n to evaluate at."
      },
      {
        "point": "singular matrix",
        "statement": "When A.det = 0, cramerMap A b i is still a well-defined determinant, but the Cramer's rule identity A.det • x = cramerMap A b degenerates and does not directly yield a solution.",
        "note": "The definition imposes no invertibility requirement; output is always defined."
      }
    ]
  },
  "axiom_baseline": [
    "Classical.choice",
    "Quot.sound",
    "propext"
  ],
