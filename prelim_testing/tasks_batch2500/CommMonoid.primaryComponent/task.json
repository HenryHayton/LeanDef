    ],
    "conventions": [
      {
        "point": "p = 0",
        "statement": "When p = 0, every element of G belongs to VTask.primaryComponent G 0 because 0^k = 0 for k ≥ 1, making g^0 = 1 hold trivially.",
        "note": "Junk value: p = 0 is not a prime but the definition is total and returns the full submonoid."
      },
      {
        "point": "p = 1",
        "statement": "When p = 1, only the identity element belongs to VTask.primaryComponent G 1, since 1^k = 1 for all k, so g^1 = g must equal 1.",
        "note": "Junk value: p = 1 is not a prime; the result is the trivial submonoid."
      },
      {
        "point": "p not prime",
        "statement": "The definition is valid for any natural number p, but the intended mathematical interpretation (elements of p-power order) is only meaningful when p is prime.",
        "note": "Convention: prime hypothesis is not enforced by the type."
      }
    ]
  },
