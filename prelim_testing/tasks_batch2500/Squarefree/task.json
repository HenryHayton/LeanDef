    "conventions": [
      {
        "point": "Units are squarefree",
        "statement": "For any unit u in a monoid, VTask.Squarefree u holds because x * x ∣ u implies x is a unit.",
        "note": "Standard consequence of unit divisibility."
      },
      {
        "point": "Zero is not squarefree in nontrivial rings",
        "statement": "In a nontrivial ring, VTask.Squarefree 0 fails because x * x ∣ 0 for all x, yet not every x is a unit.",
        "note": "Edge case: the predicate is total but evaluates to False for 0 in most rings."
      }
    ]
  },
