  "signature": {
    "name": "VTask.indefiniteDiagonal",
    "type": "(p : Type u_2) -> (q : Type u_3) -> (R : Type u₂) -> [DecidableEq p] -> [DecidableEq q] -> [CommRing R] -> Matrix (p ⊕ q) (p ⊕ q) R",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "p",
      "q",
      "R"
    ],
    "conventions": [
      {
        "point": "off-diagonal entries",
        "statement": "All entries where the row index differs from the column index are 0, regardless of which summand (inl or inr) the indices belong to.",
        "note": "Follows from the definition as a diagonal matrix."
      },
      {
        "point": "empty p",
        "statement": "When p is empty, the matrix has no inl-indexed rows or columns, and all diagonal entries are -1 (the -1 block over q).",
        "note": "Degenerate case where the positive-definite block disappears."
      },
      {
        "point": "empty q",
        "statement": "When q is empty, the matrix has no inr-indexed rows or columns, and all diagonal entries are 1, making it the identity matrix.",
        "note": "Degenerate case where the negative-definite block disappears."
      }
    ]
  },
  "axiom_baseline": [
    "Quot.sound",
    "propext"
  ],
  "admissibility_contract": {
    "single_declaration": true
  },
