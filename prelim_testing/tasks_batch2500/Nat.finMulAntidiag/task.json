  "domain": {
    "constraint": "True",
    "variables": [
      "d",
      "n"
    ],
    "conventions": [
      {
        "point": "n = 0",
        "statement": "VTask.finMulAntidiag d 0 = ∅ for all d",
        "note": "Defined to be empty when n = 0, even though tuples containing zeros could formally have product 0; this excludes zero entries from all tuples by convention."
      },
      {
        "point": "d = 0 ∧ n ≠ 1",
        "statement": "VTask.finMulAntidiag 0 n = ∅ when n ≠ 1",
        "note": "The empty product is 1, so no 0-tuple has product n for n ≠ 1; the set is empty."
      },
      {
        "point": "d = 0 ∧ n = 1",
        "statement": "VTask.finMulAntidiag 0 1 = {fun _ => 1}",
        "note": "The unique 0-tuple has empty product equal to 1, so this singleton is the only element."
      }
    ]
  },
