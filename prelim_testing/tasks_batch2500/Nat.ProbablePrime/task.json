    "name": "VTask.ProbablePrime",
    "type": "(n b : ℕ) -> Prop",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "n",
      "b"
    ],
    "conventions": [
      {
        "point": "base 0 or 1",
        "statement": "Every natural number n is a probable prime to base 0 and to base 1, because b^(n-1) - 1 = 0 in ℕ in both cases (truncated subtraction), and every n divides 0.",
        "note": "Consequence of truncated natural number subtraction."
      },
      {
        "point": "n = 0 or n = 1",
        "statement": "0 and 1 are probable primes to every base: 0 divides 0, and 1 divides everything.",
        "note": "Degenerate divisibility in ℕ."
      },
      {
        "point": "subtraction is truncated",
        "statement": "The expression b^(n-1) - 1 uses natural number subtraction, which is 0 whenever b^(n-1) ≤ 1; this means the condition collapses to n ∣ 0 in those cases.",
        "note": "Key junk-value behavior arising from ℕ subtraction."
      }
    ]
  },
  "axiom_baseline": [
    "propext"
  ],
  "admissibility_contract": {
    "single_declaration": true
  },
