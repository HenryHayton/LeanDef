  "signature": {
    "name": "VTask.finRotate",
    "type": "(n : ℕ) -> Equiv.Perm (Fin n)",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "n"
    ],
    "conventions": [
      {
        "point": "n = 0",
        "statement": "VTask.finRotate 0 is the identity permutation on the empty type Fin 0.",
        "note": "Fin 0 has no elements; the identity is the only possible permutation."
      },
      {
        "point": "n = 1",
        "statement": "VTask.finRotate 1 equals the identity permutation on the singleton Fin 1.",
        "note": "The sole element 0 maps to itself; there is no non-trivial rotation."
      },
      {
        "point": "last element wraps to zero",
        "statement": "For any n, VTask.finRotate (n + 1) applied to the last element Fin.last n returns 0.",
        "note": "This is the unique wrap-around case that distinguishes rotation from a plain increment."
      }
    ]
  },
