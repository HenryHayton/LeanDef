      },
      {
        "point": "r = 0",
        "statement": "VTask.clog b 0 = 0 for all b",
        "note": "Zero argument yields 0 via the floor/ceiling conventions on the underlying natural-number log."
      },
      {
        "point": "r = 1",
        "statement": "VTask.clog b 1 = 0 for all b",
        "note": "b^0 = 1 ≥ 1, and no smaller power suffices, so the ceiling log is 0."
      }
    ]
