  "domain": {
    "constraint": "True",
    "variables": [
      "d",
      "j"
    ],
    "conventions": [
      {
        "point": "j out of bounds",
        "statement": "When j ≥ d, no valid index into the length-d holor equals j, so VTask.unitVec d j is the all-zero holor of length d.",
        "note": "The definition is total; out-of-bounds j yields a zero holor without error."
      },
      {
        "point": "d = 0",
        "statement": "When d = 0, the holor has no valid indices, so VTask.unitVec 0 j is the empty holor for any j.",
        "note": "Vacuously consistent with the general rule."
      }
    ]
  },
