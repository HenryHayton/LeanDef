  "signature": {
    "name": "VTask.gammaSet",
    "type": "(N r : ℕ) -> (a : Fin 2 → ZMod N) -> Set (Fin 2 → ℤ)",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "N",
      "r",
      "a"
    ],
    "conventions": [
      {
        "point": "N = 1",
        "statement": "When N = 1 the congruence condition is vacuous, so VTask.gammaSet 1 r a = {v : Fin 2 → ℤ | (v 0).gcd (v 1) = r} for every choice of a.",
        "note": "Proved as gammaSet_one_eq in Mathlib."
      },
      {
        "point": "r = 0",
        "statement": "The GCD of two integers equals 0 iff both are 0, so VTask.gammaSet N 0 a is {(0,0)} when a is the zero residue class and empty otherwise.",
        "note": "Follows from Int.gcd_eq_zero_iff."
      },
      {
        "point": "N = 0",
        "statement": "When N = 0, ZMod 0 = ℤ so the congruence condition requires the integer pair to equal a exactly, making the set either a singleton or empty depending on the GCD condition.",
        "note": "ZMod 0 is definitionally ℤ in Mathlib."
      }
    ]
  },
