  "signature": {
    "name": "VTask.Shortlex",
    "type": "{α : Type u_1} -> (r : α → α → Prop) -> List α → List α → Prop",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "s",
      "t"
    ],
    "conventions": [
      {
        "point": "Empty list on the right",
        "statement": "`VTask.Shortlex r s []` is always `False` for any `s` and `r`, since no list has length less than zero and the lex comparison also fails.",
        "note": "Captured by `List.not_shortlex_nil_right`."
      },
      {
        "point": "Empty list on the left vs non-empty right",
        "statement": "`VTask.Shortlex r [] s` holds for every non-empty list `s`, because `[].length = 0 < s.length`.",
        "note": "Captured by `List.shortlex_nil_or_eq_nil` and `List.Shortlex.of_length_lt`."
      },
      {
        "point": "Length determines order when lengths differ",
        "statement": "When `s.length < t.length`, `VTask.Shortlex r s t` holds unconditionally, regardless of the elements or the relation `r`.",
        "note": "Captured by `List.Shortlex.of_length_lt`."
      },
      {
        "point": "Lex comparison used only for equal-length lists",
        "statement": "When `s.length = t.length`, `VTask.Shortlex r s t` holds if and only if `List.Lex r s t`.",
        "note": "Captured by `List.shortlex_iff_lex`."
      }
    ]
  },
  "axiom_baseline": [],
