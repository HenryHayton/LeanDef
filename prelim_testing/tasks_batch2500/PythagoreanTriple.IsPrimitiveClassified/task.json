    "conventions": [
      {
        "point": "parity_requirement",
        "statement": "The parametrising integers m and n are required to have opposite parity (one even, one odd); this is part of the definition, not derived from other conditions.",
        "note": "Ensures the two expressions m²−n² and 2mn are not both even, matching the primitive case."
      },
      {
        "point": "symmetry_in_legs",
        "statement": "Both orderings of the legs are admitted: either x = m²−n² and y = 2mn, or x = 2mn and y = m²−n², so the predicate treats x and y symmetrically.",
        "note": "This reflects the fact that labelling of odd and even legs is a convention, not intrinsic."
      },
      {
        "point": "coprimality_of_parameters",
        "statement": "The witnesses m and n must satisfy gcd(m, n) = 1 (coprime as integers), independently of whether the triple itself is primitive.",
        "note": "Uses Int.gcd, returning a natural number equal to 1."
      }
    ]
  },
