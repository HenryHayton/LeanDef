    "conventions": [
      {
        "point": "n = 1",
        "statement": "When n = 1, the target group (ZMod 1)ˣ is trivial and VTask.unitsMap sends every unit of (ZMod m)ˣ to the unique element of (ZMod 1)ˣ.",
        "note": "Trivial target group."
      },
      {
        "point": "n = m",
        "statement": "When n = m and the divisibility witness is dvd_refl n, VTask.unitsMap acts as the identity homomorphism on (ZMod n)ˣ.",
        "note": "Identity case."
      },
      {
        "point": "m = 0",
        "statement": "When m = 0, ZMod 0 is identified with ℤ and its units are {1, -1}; for any n dividing 0, VTask.unitsMap reduces units of ℤ to units of ZMod n by the canonical cast.",
        "note": "Zero modulus edge case."
      }
    ]
  },
