    "variables": [
      "A"
    ],
    "conventions": [
      {
        "point": "k = 0 (empty submatrix)",
        "statement": "The 0×0 submatrix has determinant 1 by convention (empty product), which equals SignType.cast SignType.pos, so the k = 0 case is always satisfied and imposes no constraint.",
        "note": "Convention inherited from Matrix.det on empty index type."
      },
      {
        "point": "Injectivity of row/column selectors",
        "statement": "Only injective row-selection and column-selection maps are required to yield determinants in the range of SignType.cast; non-injective selections are not directly constrained by the definition.",
        "note": "In practice, non-injective submatrices have determinant 0 due to repeated rows/columns, which is also in the range, making the injectivity condition redundant in practice."
      }
    ]
  },
