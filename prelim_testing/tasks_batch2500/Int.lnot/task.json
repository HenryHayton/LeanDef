  "domain": {
    "constraint": "True",
    "variables": [
      "n"
    ],
    "conventions": [
      {
        "point": "non-negative input",
        "statement": "For a non-negative integer n : ℕ (coerced to ℤ), VTask.lnot n = -(n + 1), mapping 0,1,2,… to -1,-2,-3,…",
        "note": "Follows two's-complement convention: non-negative integers have leading 0-bits, all of which flip to 1-bits."
      },
      {
        "point": "negative input",
        "statement": "For a negative integer of the form -(m+1), VTask.lnot (-(m+1)) = m, mapping -1,-2,-3,… back to 0,1,2,…",
        "note": "Inverts the non-negative case; lnot is an involution."
      }
    ]
  },
