  "task_symbol": "VTask.openSegment",
  "signature": {
    "name": "VTask.openSegment",
    "type": "(𝕜 : Type u_1) -> {E : Type u_2} -> [Semiring 𝕜] -> [PartialOrder 𝕜] -> [AddCommMonoid E] -> [SMul 𝕜 E] -> (x y : E) -> Set E",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "x",
      "y"
    ],
    "conventions": [
      {
        "point": "x = y",
        "statement": "VTask.openSegment 𝕜 x x = {x} (not ∅) whenever 𝕜 contains an element strictly between 0 and 1.",
        "note": "This is an intentional design choice: any a, b > 0 with a + b = 1 give a • x + b • x = (a + b) • x = x, so the degenerate open segment is the singleton, not empty."
      }
    ]
  },
