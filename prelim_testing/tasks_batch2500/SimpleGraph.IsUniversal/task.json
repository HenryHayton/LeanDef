  "task_symbol": "VTask.IsUniversal",
  "signature": {
    "name": "VTask.IsUniversal",
    "type": "{V : Type u} -> (G : SimpleGraph V) -> (v : V) -> Prop",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "G",
      "v"
    ],
    "conventions": [
      {
        "point": "subsingleton",
        "statement": "When the vertex type V is a subsingleton, VTask.IsUniversal G v holds vacuously for every graph G and vertex v, since there is no distinct vertex w to be adjacent to.",
        "note": "Corresponds to SimpleGraph.IsUniversal.of_subsingleton."
      },
      {
        "point": "irreflexivity",
        "statement": "The adjacency condition only applies to vertices w with w ≠ v; self-adjacency is never required (and is impossible in a simple graph), so the predicate correctly captures 'adjacent to every other vertex'.",
        "note": "Follows from the irreflexivity of SimpleGraph.Adj."
      }
    ]
  },
