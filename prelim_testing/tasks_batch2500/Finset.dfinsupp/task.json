  "signature": {
    "name": "VTask.dfinsupp",
    "type": "{ι : Type u_1} -> {α : ι → Type u_2} -> [DecidableEq ι] -> [(i : ι) → Zero (α i)] -> (s : Finset ι) -> (t : (i : ι) → Finset (α i)) -> Finset (Π₀ (i : ι), α i)",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "s",
      "t"
    ],
    "conventions": [
      {
        "point": "Indices outside s",
        "statement": "For any i ∉ s, every element f of VTask.dfinsupp s t satisfies f i = 0; the sets t i for i ∉ s are ignored entirely.",
        "note": "This is the defining convention making the output genuinely finitely-supported within s."
      },
      {
        "point": "Empty s",
        "statement": "When s = ∅, VTask.dfinsupp s t is the singleton {0}, the finset containing only the zero DFinsupp function.",
        "note": "Follows from the empty Cartesian product being a single empty function, mapped to the zero DFinsupp."
      },
      {
        "point": "Empty t i for i ∈ s",
        "statement": "If t i = ∅ for some i ∈ s, then VTask.dfinsupp s t = ∅, since no valid assignment exists.",
        "note": "Inherited from the emptiness of the pi finset when any factor is empty."
      }
    ]
  },
