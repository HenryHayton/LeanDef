    "name": "VTask.valMinAbs",
    "type": "{n : ℕ} -> ZMod n → ℤ",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "n",
      "x"
    ],
    "conventions": [
      {
        "point": "n = 0",
        "statement": "When n = 0, ZMod 0 is ℤ and VTask.valMinAbs acts as the identity, returning x itself.",
        "note": "This is a degenerate case where no modular reduction is needed."
      },
      {
        "point": "result interval for n > 0",
        "statement": "For positive n, the result r satisfies r * 2 ∈ Set.Ioc (-n : ℤ) n, i.e., -n < 2*r ≤ n; the upper boundary n/2 is included and the lower boundary is excluded.",
        "note": "This means when n is even, the representative n/2 is preferred over -(n/2)."
      },
      {
        "point": "round-trip",
        "statement": "The result always casts back to the original element: (x.valMinAbs : ZMod n) = x.",
        "note": "This ensures valMinAbs picks a genuine representative of the same equivalence class."
      },
      {
        "point": "injectivity",
        "statement": "VTask.valMinAbs is injective: if two elements of ZMod n have the same valMinAbs, they are equal.",
        "note": "This follows because distinct residue classes have distinct closest-to-zero representatives."
      }
    ]
  },
