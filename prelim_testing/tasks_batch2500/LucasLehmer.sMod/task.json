    ],
    "conventions": [
      {
        "point": "p = 0",
        "statement": "When p = 0 the modulus is 2^0 - 1 = 0, and integer remainder modulo 0 is defined as 0 in Lean, so VTask.sMod 0 i = 0 for all i.",
        "note": "Junk-value convention for degenerate modulus; nonnegativity and strict-upper-bound theorems require p ≠ 0."
      },
      {
        "point": "p = 1",
        "statement": "When p = 1 the modulus is 1, and every integer is congruent to 0 modulo 1, so VTask.sMod 1 i = 0 for all i.",
        "note": "Edge case where the modulus collapses the sequence to the constant 0."
      }
    ]
  },
