    "conventions": [
      {
        "point": "m = 0",
        "statement": "VTask.countRestricted n 0 is empty for n > 0 and equals {∅} for n = 0, because no part can satisfy count i < 0.",
        "note": "Junk-value convention: m = 0 makes the multiplicity bound impossible to satisfy."
      },
      {
        "point": "m = 1",
        "statement": "VTask.countRestricted n 1 is empty for n > 0 and equals {∅} for n = 0, because every part that appears has count ≥ 1, which is not < 1.",
        "note": "Edge case: m = 1 forces the empty partition to be the only possible member."
      },
      {
        "point": "m = 2",
        "statement": "VTask.countRestricted n 2 equals distincts n, the finset of partitions of n into pairwise distinct parts.",
        "note": "Special case: proven as countRestricted_two in Mathlib."
      },
      {
        "point": "m > n",
        "statement": "When m > n, the multiplicity bound is never binding and VTask.countRestricted n m equals the finset of all partitions of n.",
        "note": "No part of a partition of n can appear more than n times."
      }
    ]
  },
