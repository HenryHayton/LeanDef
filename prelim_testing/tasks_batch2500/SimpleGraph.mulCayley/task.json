  "signature": {
    "name": "VTask.mulCayley",
    "type": "{M : Type u_1} -> (s : Set M) -> [Mul M] -> SimpleGraph M",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "s",
      "M"
    ],
    "conventions": [
      {
        "point": "self_loops_excluded",
        "statement": "The adjacency relation is irreflexive: even if some generator g in s satisfies x * g = x, the vertex x is not considered adjacent to itself.",
        "note": "Enforced by the SimpleGraph contract, which always removes self-loops."
      },
      {
        "point": "symmetrisation",
        "statement": "The edge relation is automatically symmetrised: x is adjacent to y if and only if y is adjacent to x, regardless of whether M is commutative or s is inverse-closed.",
        "note": "Symmetry is imposed by fromRel, not by any algebraic property of M or s."
      },
      {
        "point": "empty_generators",
        "statement": "When s is the empty set, the resulting graph has no edges — all vertices are isolated.",
        "note": "No generator exists to witness the adjacency relation, so the relation is everywhere false before symmetrisation."
      },
      {
        "point": "no_group_structure_required",
        "statement": "M need not be a group, monoid, or have any invertibility; only a binary multiplication [Mul M] is required.",
        "note": "This generalises the classical Cayley graph construction beyond groups."
      }
    ]
  },
  "axiom_baseline": [
    "Quot.sound",
    "propext"
  ],
  "admissibility_contract": {
    "single_declaration": true
  },
