  "schema_version": "1.1",
  "task_symbol": "VTask.toSubgraph",
  "signature": {
    "name": "VTask.toSubgraph",
    "type": "{V : Type u} -> {G : SimpleGraph V} -> {u v : V} -> G.Walk u v → G.Subgraph",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "p"
    ],
    "conventions": [
      {
        "point": "nil walk",
        "statement": "VTask.toSubgraph (Walk.nil : G.Walk u u) = G.singletonSubgraph u, the subgraph containing only the vertex u and no edges.",
        "note": "Base case of the recursive definition; nil walk at u yields the singleton subgraph at u."
      },
      {
        "point": "cons walk",
        "statement": "VTask.toSubgraph (Walk.cons h p) = G.subgraphOfAdj h ⊔ VTask.toSubgraph p, the join of the single-edge subgraph for h and the subgraph of the tail.",
        "note": "Recursive case: prepending an edge h to a walk joins the subgraph of that edge with the subgraph of the rest."
      }
    ]
  },
  "axiom_baseline": [
    "Classical.choice",
    "Quot.sound",
    "propext"
  ],
