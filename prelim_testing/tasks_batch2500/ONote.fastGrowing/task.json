    ],
    "conventions": [
      {
        "point": "zero ordinal",
        "statement": "When the ordinal notation has fundamental sequence `Sum.inl none` (identifying it as the zero or base case), VTask.fastGrowing returns Nat.succ regardless of the natural number argument.",
        "note": "This covers 0 and any ONote whose fundamentalSequence is inl none."
      },
      {
        "point": "successor ordinal",
        "statement": "When the ordinal notation has fundamental sequence `Sum.inl (some a)`, VTask.fastGrowing at that ordinal is n ↦ (fastGrowing a)^[n] n, i.e., the previous level iterated n times applied to n.",
        "note": "Iteration count and starting point are both n."
      },
      {
        "point": "limit ordinal",
        "statement": "When the ordinal notation has fundamental sequence `Sum.inr f`, VTask.fastGrowing at that ordinal is n ↦ fastGrowing (f n) n, diagonalising over the fundamental sequence.",
        "note": "The fundamental sequence index and the function argument are both n."
      }
    ]
  },
