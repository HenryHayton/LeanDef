  "task_symbol": "VTask.LiftRel",
  "signature": {
    "name": "VTask.LiftRel",
    "type": "{α : Type u} -> {β : Type v} -> (R : α → β → Prop) -> (ca : Computation α) -> (cb : Computation β) -> Prop",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "R",
      "ca",
      "cb"
    ],
    "conventions": [
      {
        "point": "Both computations diverge",
        "statement": "If both `ca` and `cb` diverge (never produce a value), then `VTask.LiftRel R ca cb` holds vacuously for any relation `R`, because both universal premises are empty.",
        "note": "Vacuous truth from empty membership"
      },
      {
        "point": "One diverges, one terminates",
        "statement": "If exactly one of `ca` or `cb` terminates with a value while the other diverges, then `VTask.LiftRel R ca cb` is false, because the terminating side cannot be matched by the diverging side.",
        "note": "Asymmetric termination breaks the bilateral correspondence"
      }
    ]
  },
  "axiom_baseline": [],
  "admissibility_contract": {
    "single_declaration": true
  },
