  "task_id": "Nat.ofDigits",
  "schema_version": "1.1",
  "task_symbol": "VTask.ofDigits",
  "signature": {
    "name": "VTask.ofDigits",
    "type": "{α : Type u_1} -> [Semiring α] -> (b : α) -> List ℕ → α",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "b",
      "L"
    ],
    "conventions": [
      {
        "point": "L = []",
        "statement": "VTask.ofDigits b [] = 0 for any base b and any semiring α.",
        "note": "Empty list yields the additive identity of the semiring."
      },
      {
        "point": "all digits are 0",
        "statement": "VTask.ofDigits b (List.replicate k 0) = 0 for any base b and any k.",
        "note": "A list of all zeros always evaluates to zero regardless of base."
      },
      {
        "point": "trailing zeros",
        "statement": "VTask.ofDigits b (l ++ List.replicate k 0) = VTask.ofDigits b l for any l, k, b.",
        "note": "Appending zero digits at the high end does not change the value."
      },
      {
        "point": "base b = 1 over ℕ",
        "statement": "VTask.ofDigits 1 L = L.sum for any list L of natural numbers.",
        "note": "When the base is 1, positional weights all equal 1 so the result is the digit sum."
      }
    ]
  },
