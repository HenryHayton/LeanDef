    "name": "VTask.boundary",
    "type": "{n : ℕ} -> (c : Composition n) -> Fin (c.length + 1) ↪o Fin (n + 1)",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "n",
      "c"
    ],
    "conventions": [
      {
        "point": "i = 0",
        "statement": "VTask.boundary c 0 = 0; the 0th boundary is always the leftmost point of the composition.",
        "note": "Corresponds to the theorem boundary_zero."
      },
      {
        "point": "i = Fin.last c.length",
        "statement": "VTask.boundary c (Fin.last c.length) = Fin.last n; the virtual last index maps to n, one past the final element.",
        "note": "Corresponds to the theorem boundary_last; this virtual point ensures a clean bijection with CompositionAsSet."
      }
    ]
  },
