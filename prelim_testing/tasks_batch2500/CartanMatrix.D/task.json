  "task_symbol": "VTask.D",
  "signature": {
    "name": "VTask.D",
    "type": "(n : ℕ) -> Matrix (Fin n) (Fin n) ℤ",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "n"
    ],
    "conventions": [
      {
        "point": "n = 0",
        "statement": "VTask.D 0 is the unique 0×0 empty integer matrix; no root system interpretation applies.",
        "note": "Junk value: no simple Lie algebra of rank 0 of type D exists."
      },
      {
        "point": "n = 1",
        "statement": "VTask.D 1 equals the 1×1 matrix [[2]], which coincides with VTask.A 1; D₁ is not conventionally a valid Dynkin diagram type.",
        "note": "Degenerate case; returned value matches A₁ by theorem."
      },
      {
        "point": "n = 2",
        "statement": "VTask.D 2 equals the 2×2 diagonal matrix [[2,0],[0,2]] with all off-diagonal entries 0, because the branch n ≤ 2 forces all off-diagonal entries to zero.",
        "note": "D₂ corresponds to a disconnected diagram (two A₁ components), not an irreducible root system."
      },
      {
        "point": "n = 3",
        "statement": "VTask.D 3 equals [[2,−1,−1],[−1,2,0],[−1,0,2]] and is isomorphic to VTask.A 3 under a reindexing, reflecting the classical Lie algebra isomorphism so(6) ≅ sl(4).",
        "note": "Special small-rank coincidence; both are valid Cartan matrices but for nominally different types."
      }
    ]
  },
