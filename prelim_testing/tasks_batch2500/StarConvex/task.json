    "conventions": [
      {
        "point": "Empty set",
        "statement": "VTask.StarConvex 𝕜 x ∅ is vacuously true for any x, since there are no points y ∈ ∅ to check.",
        "note": "Standard vacuous universal quantification."
      },
      {
        "point": "Center membership",
        "statement": "When s is nonempty and 𝕜 has ZeroLEOneClass, VTask.StarConvex 𝕜 x s implies x ∈ s; without ZeroLEOneClass the center need not belong to s.",
        "note": "Governed by StarConvex.mem in Mathlib."
      },
      {
        "point": "No topological structure required",
        "statement": "The predicate is stated purely algebraically via an ordered semiring and additive commutative monoid; no norm, metric, or topological space is assumed.",
        "note": "Allows use in purely algebraic settings."
      }
    ]
  },
