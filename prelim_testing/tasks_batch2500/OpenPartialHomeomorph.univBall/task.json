  "task_id": "OpenPartialHomeomorph.univBall",
  "schema_version": "1.1",
  "task_symbol": "VTask.univBall",
  "signature": {
    "name": "VTask.univBall",
    "type": "{E : Type u_1} -> [SeminormedAddCommGroup E] -> [NormedSpace ℝ E] -> {P : Type u_2} -> [PseudoMetricSpace P] -> [NormedAddTorsor E P] -> (c : P) -> (r : ℝ) -> OpenPartialHomeomorph E P",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "True",
    "variables": [
      "c",
      "r"
    ],
    "conventions": [
      {
        "point": "r > 0",
        "statement": "When r > 0, the source is Set.univ, the target is Metric.ball c r, and the map is a smooth diffeomorphism from all of E onto that open ball.",
        "note": "Primary intended use case."
      },
      {
        "point": "r ≤ 0",
        "statement": "When r ≤ 0, the map is defined as the isometric translation by c (the torsor vadd action), with source Set.univ but target not restricted to any ball; no compression occurs.",
        "note": "Junk/degenerate value convention: the definition is total and always returns a well-typed OpenPartialHomeomorph, but the ball-targeting property is lost."
      },
      {
        "point": "r = 0 or r < 0, value at 0",
        "statement": "In all cases (including r ≤ 0), the map sends 0 to c.",
        "note": "Universally guaranteed by univBall_apply_zero."
      }
    ]
  },
  "axiom_baseline": [
    "Classical.choice",
    "Quot.sound",
    "propext"
  ],
  "admissibility_contract": {
    "single_declaration": true
  },
