    "conventions": [
      {
        "point": "membership_condition_omitted",
        "statement": "The condition `a ∈ s` is not stated explicitly; it is implied by `s' + {a} = s + t` together with irreflexivity of `r` (which prevents `a ∈ t`).",
        "note": "Avoids DecidableEq and simplifies verification for explicit multisets."
      },
      {
        "point": "erase_avoided",
        "statement": "The equivalent identity `s' + {a} = s + t` is used instead of `s' = s.erase a + t` so that no `DecidableEq` instance on `α` is required.",
        "note": "cutExpand_iff recovers the erase formulation under DecidableEq and Irrefl."
      }
    ]
  },
