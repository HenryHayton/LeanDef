  "schema_version": "1.1",
  "task_symbol": "VTask.prev",
  "signature": {
    "name": "VTask.prev",
    "type": "{α : Type u_1} -> [DecidableEq α] -> (l : List α) -> (x : α) -> x ∈ l → α",
    "imports": [
      "Mathlib"
    ]
  },
  "domain": {
    "constraint": "x ∈ l",
    "variables": [
      "l",
      "x"
    ],
    "conventions": [
      {
        "point": "singleton list",
        "statement": "For a singleton list `[y]`, `VTask.prev [y] x h = y` for any `x` (which must equal `y`).",
        "note": "The sole element is its own cyclic predecessor."
      },
      {
        "point": "head element wraps to last",
        "statement": "When `x` is the head of a list of length ≥ 2, `VTask.prev l x h = l.getLast`.",
        "note": "Cyclic convention: the element before the first is the last."
      },
      {
        "point": "first occurrence used for duplicates",
        "statement": "When `x` appears more than once in `l`, only the first occurrence determines the predecessor; later occurrences are ignored.",
        "note": "Documented explicitly in the docstring with examples."
      }
    ]
  },
  "axiom_baseline": [
    "propext"
  ],
  "admissibility_contract": {
    "single_declaration": true
  },
