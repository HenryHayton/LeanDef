    ],
    "conventions": [
      {
        "point": "s = t",
        "statement": "When s = t, the operation replaces t's neighbourhood with itself and suppresses the s–t = t–t loop (already absent), so the graph is effectively unchanged.",
        "note": "Junk-value regime: the definition is still well-typed and produces a valid simple graph."
      },
      {
        "point": "s–t edge suppression",
        "statement": "The edge between s and t is always absent in VTask.replaceVertex G s t, regardless of whether G.Adj s t holds.",
        "note": "This is a structural convention of the construction, not an extra postcondition."
      },
      {
        "point": "No loops",
        "statement": "t is never adjacent to itself in VTask.replaceVertex G s t, consistent with the simple graph requirement.",
        "note": "Inherited from the simple graph axioms applied to the defined adjacency predicate."
      }
    ]
  },
