    ],
    "conventions": [
      {
        "point": "n = 0",
        "statement": "VTask.ModEq 0 a b holds if and only if a = b, because a % 0 = a for all natural numbers a in Lean.",
        "note": "Junk-value convention: division by zero in Nat gives quotient 0 and remainder equal to the dividend."
      },
      {
        "point": "n = 1",
        "statement": "VTask.ModEq 1 a b holds for all a and b, because every natural number has remainder 0 modulo 1.",
        "note": "Degenerate modulus making the relation trivially universal."
      }
    ]
  },
